{
  "common": {
    "name": "filesync",
    "version": "0.1.0",
    "titleLang": {
      "en": "FileSync",
      "de": "FileSync"
    },
    "desc": {
      "en": "Secure synchronization between local, SMB2/3 and SFTP storage",
      "de": "Sichere Synchronisation zwischen lokalen, SMB2/3- und SFTP-Speichern"
    },
    "authors": [
      "DerHausmeisterKrause"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "storage",
    "compact": true,
    "connectionType": "local",
    "dataSource": "push",
    "icon": "filesync.svg",
    "adminUI": {
      "config": "materialize"
    },
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/DerHausmeisterKrause/iobroker.filesync/main/admin/filesync.svg",
    "keywords": [
      "files",
      "sync",
      "smb",
      "sftp"
    ],
    "readme": "https://github.com/DerHausmeisterKrause/iobroker.filesync/blob/main/README.md",
    "loglevel": "info",
    "messagebox": true,
    "supportCustoms": false,
    "tier": 3,
    "dependencies": [
      {
        "js-controller": ">=7.2.0"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.9.0"
      }
    ],
    "news": {
      "0.1.0": {
        "en": "Initial release",
        "de": "Erste Veröffentlichung"
      }
    }
  },
  "native": {
    "configVersion": 1,
    "locations": [],
    "jobs": [],
    "groups": [],
    "notifications": [],
    "maxConcurrentTransfers": 2,
    "healthIntervalSeconds": 300,
    "auditRetention": 500,
    "credentialVault": "{}"
  },
  "encryptedNative": [
    "credentialVault"
  ],
  "protectedNative": [
    "credentialVault"
  ],
  "objects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Connected",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.activeJobs",
      "type": "state",
      "common": {
        "name": "Active jobs",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.failedJobs",
      "type": "state",
      "common": {
        "name": "Failed jobs",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.queuedTransfers",
      "type": "state",
      "common": {
        "name": "Queued transfers",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    }
  ],
  "instanceObjects": []
}
