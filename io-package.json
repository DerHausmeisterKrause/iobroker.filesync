{
  "common": {
    "name": "filesync",
    "version": "0.2.12",
    "titleLang": {
      "en": "FileSync",
      "de": "FileSync"
    },
    "desc": {
      "en": "Secure synchronization between local, SMB2/3 and SFTP storage",
      "de": "Sichere Synchronisation zwischen lokalen, SMB2/3- und SFTP-Speichern"
    },
    "authors": [
      "DerHausmeisterKrause"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "type": "storage",
    "compact": true,
    "connectionType": "local",
    "dataSource": "push",
    "icon": "filesync.png",
    "adminUI": {
      "config": "json"
    },
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/DerHausmeisterKrause/iobroker.filesync/main/admin/filesync.png",
    "keywords": [
      "files",
      "sync",
      "smb",
      "sftp"
    ],
    "readme": "https://github.com/DerHausmeisterKrause/iobroker.filesync/blob/main/README.md",
    "loglevel": "info",
    "messagebox": true,
    "supportCustoms": false,
    "tier": 3,
    "dependencies": [
      {
        "js-controller": ">=7.2.0"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=7.9.0"
      }
    ],
    "news": {
      "0.2.12": {
        "en": "Correct SMB directory enumeration continuation requests",
        "de": "SMB-Ordnerauflistung und Folgeanfragen korrigiert"
      },
      "0.2.11": {
        "en": "SMB 2.0.2 compatibility and explicit dialect selection",
        "de": "SMB 2.0.2 und manuelle Protokollauswahl"
      },
      "0.2.10": {
        "en": "Simplified SMB network path editor",
        "de": "Einfacher SMB-Netzwerkpfad und Domänenbenutzer"
      },
      "0.2.9": {
        "en": "Native SMB 2.1/3.x with NTLMv2 and signing",
        "de": "Natives SMB 2.1/3.x mit NTLMv2 und Signing"
      },
      "0.2.8": {
        "en": "Isolate SMB connection crashes and improve error recovery",
        "de": "SMB-Verbindungsabstürze isolieren und Fehlerbehandlung verbessern"
      },
      "0.2.7": {
        "en": "FileSync logo and quick installation guide",
        "de": "FileSync-Logo und Schnellinstallation"
      },
      "0.2.6": {
        "en": "Test mail, delivery history and daily/weekly reports",
        "de": "Testmail, Versandhistorie und Tages-/Wochenberichte"
      },
      "0.2.5": {
        "en": "Personal email notifications and central mail transport",
        "de": "Persönliche E-Mail-Benachrichtigungen und zentraler Mailversand"
      },
      "0.2.4": {
        "en": "Detailed access diagnostics and failure progress",
        "de": "Detaillierte Zugriffsprüfung und Fortschritt bei Fehlern"
      },
      "0.2.3": {
        "en": "Immediate synchronization without stability delay",
        "de": "Sofortige Synchronisation ohne Stabilitätswartezeit"
      },
      "0.2.2": {
        "en": "Fix TypeScript installation build",
        "de": "TypeScript-Installationsfehler behoben"
      },
      "0.2.1": {
        "en": "Version diagnostics and interrupted run recovery",
        "de": "Versionsdiagnose und Behandlung unterbrochener Runs"
      },
      "0.2.0": {
        "en": "Live job and file transfer progress",
        "de": "Live-Fortschritt für Jobs und Dateien"
      },
      "0.1.2": {
        "en": "Run history filters and improved details",
        "de": "Run-Filter und verbesserte Details"
      },
      "0.1.1": {
        "en": "Safer Move and Mirror operations",
        "de": "Sicherere Move- und Mirror-Synchronisation"
      },
      "0.1.0": {
        "en": "Initial release",
        "de": "Erste Veröffentlichung"
      }
    }
  },
  "native": {
    "configVersion": 2,
    "locations": [],
    "jobs": [],
    "groups": [],
    "notifications": [],
    "maxConcurrentTransfers": 2,
    "healthIntervalSeconds": 300,
    "auditRetention": 500,
    "credentialVault": "",
    "web": {
      "enabled": true,
      "port": 8095,
      "secure": false,
      "bind": "0.0.0.0",
      "sessionTtlMinutes": 480,
      "certPublic": "",
      "certPrivate": "",
      "certChained": ""
    },
    "webGroups": [],
    "webUsers": [],
    "emailEnabled": false,
    "emailInstance": "email.0"
  },
  "encryptedNative": [
    "credentialVault"
  ],
  "protectedNative": [
    "credentialVault"
  ],
  "objects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": "Connected",
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.activeJobs",
      "type": "state",
      "common": {
        "name": "Active jobs",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.failedJobs",
      "type": "state",
      "common": {
        "name": "Failed jobs",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.queuedTransfers",
      "type": "state",
      "common": {
        "name": "Queued transfers",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "info.webServerRunning",
      "type": "state",
      "common": {
        "name": "Web server running",
        "type": "boolean",
        "role": "value",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.webServerPort",
      "type": "state",
      "common": {
        "name": "Web server port",
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 8095
      },
      "native": {}
    },
    {
      "_id": "info.webServerSecure",
      "type": "state",
      "common": {
        "name": "Web server secure",
        "type": "boolean",
        "role": "value",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "info.webServerUrl",
      "type": "state",
      "common": {
        "name": "Web server URL",
        "type": "string",
        "role": "value",
